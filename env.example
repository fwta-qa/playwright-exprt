# .env
# Copy this file to .env and fill in your values

# Your Gmail address (the one that will receive the OTP)
GMAIL_ADDRESS=qa.socoe@gmail.com

# Optional: override the login URL
SSO_URL=https://demo.aliance.club/sso/login/

# Dev/demo mode: bypass Gmail and use a fixed "decoy" OTP
# - Set DECOY_OTP=true to skip Gmail polling and always enter DECOY_OTP_CODE
DECOY_OTP=true
DECOY_OTP_CODE=122222

# Set USE_2FA=true only if the SSO login page requires clicking the "Login Via 2FA Code" button
# before OTP input fields appear. Set to false (default) to skip that click.
USE_2FA=false

# Company and Module Selection
# - COMPANY_NAME: Name of the company to select
# - MODULE_NAME: Name of the module/submodule to select (e.g., "JobSarawak")
COMPANY_NAME=SYARIKAT PEMBANGUNAN PESAWAT SEMBILAN SEPTEMBER
ADMIN_EMAIL=jsdemo.perkeso@outlook.com
MODULE_NAME=EXPRT
# Module tile clicked on the ADMIN/officer side after login. Officer/admin
# accounts don't show a "SANSOLS" tile directly (that label only appears on
# the employer side) — "Genesis" is the real gateway into the SANSOLS admin
# area for officer roles.
MODULE_NAME_ADMIN=Genesis

# Application type to create when clicking the + (Add) button on the Job Listing page.
# Options: new (default) | renew
AL_APPLICATION_TYPE=new

# Pass type to choose for a new application.
# Options: ep (default, Employment Pass) | pvp (Professional Visit Pass)
AL_PASS_TYPE=ep

# Expat worker category to select for the FIRST expatriate worker only.
# Options: specialist (default: Specialist / Shareholding) | crossposting (Cross-Posting) | others (Others)
AL_EXPAT_TYPE=specialist

# How many expatriate workers to add under Expatriate Details (default: 1).
# Worker #1 uses AL_EXPAT_TYPE above. Set AL_EXPAT_TYPE_ADDITIONAL to assign
# the same category to every worker after the first; leave it blank to randomly
# assign additional workers either Cross-Posting or Others.
AL_EXPAT_TYPE_ADDITIONAL=
EXPAT_COUNT=1

# Path to the PDF file to upload for Radio Attachments (use forward slashes or double backslashes)
# Example: C:/Users/USER/Documents/radio-ad.pdf
PDF_UPLOAD_PATH=C:/Users/USER/Downloads/playwright-js-testfile/radio-ad.pdf

# Control whether the script processes Local Understudy Candidates (true / false)
ADD_LOCAL_CANDIDATES=false

# Specify exactly how many candidates you want to create and fill
CANDIDATE_COUNT=1

# Gate for the final "Submit" button on the Employer's Declaration page.
# The declaration explicitly states submission is legally binding and
# triggers payment obligations, so this defaults to false. Only set to
# "true" when you intend to actually submit the application (e.g. in a
# test/sandbox environment).
SUBMIT_APPLICATION=false

# Run admin-approve-application.test.js against a SPECIFIC existing
# application, without needing to run al-autofill-form.test.js first.
# Set BOTH values together (applicationId is the UUID from the app's URL
# ?id=... param; referenceNo is the short code shown as "No. XXXXXX" on the
# employer side, e.g. "YTHMFC" — required for the admin-side search step).
# Leave both empty to fall back to .test-state/last-application-id.json,
# written automatically by the most recent al-autofill-form.test.js run.
APPLICATION_ID=
APPLICATION_REF_NO=

# Credentials for the internal QA "Tools" dashboard (api-demo.e-vdr.com),
# used to look up which government officer is assigned to approve a given
# AL application via /qa/approval/waiting/{id}, and to bypass the proforma
# waiting period via /qa/approval/promote_proforma/expat/{id}.
QA_TOOLS_BASE_URL=https://api-demo.e-vdr.com
QA_TOOLS_USERNAME=
QA_TOOLS_PASSWORD=

# Admin review decision for each expatriate worker on the application, at
# every JIMS-style stage (jims_officer_expat, jims_hq_officer_expat, DSS).
# Options: recommend (default) | not_recommend | random (50/50 per worker)
ADMIN_RECOMMENDATION=recommend

# Gate for the final "ACCEPT"/"SUBMIT"/"REVIEW" button at every stage of the
# admin approval chain. This advances the whole application to the NEXT
# officer in the hierarchy, so it defaults to false. Only set to "true" when
# you intend to actually walk the application through the full chain (e.g.
# in a test/sandbox environment).
ADMIN_ACCEPT_REVIEW=false

# Controls the "Site Inspection Required" checkbox at the JKLE
# (ilmu_officer) review stage. The Recommend/Not Recommend control only
# renders once this checkbox is UNCHECKED. Site inspection is a
# time-consuming extra workflow, so this defaults to false (checkbox
# unchecked, decision control shown). Set to "true" to leave it checked
# (decision control stays hidden, Remarks-only).
SITE_INSPECTION_REQUIRED=false

# Controls the "DSS Review" radio button at the ILMU Director (ilmu_dir)
# review stage.
# Options: optional (default, faster approval path) | mandatory
DSS_REVIEW=optional

# Final AL approval decision at the State Secretary stage (last stage in
# the whole approval chain). Buttons here read "Approve" / "Reject" rather
# than "Recommend" / "Not Recommend" used by every earlier stage, so this
# gets its own dedicated ENV var instead of reusing ADMIN_RECOMMENDATION.
# Options: approve (default) | reject | random
STATE_SECRETARY_DECISION=approve

# When submitting the JKLE (ilmu_officer) stage without assigning a JKLE
# agency, a "No Mandatory JKLE Agency Selected" confirmation popup appears.
# Options: confirm (default, proceed without assigning one) | cancel
JKLE_AGENCY_CONFIRM=confirm

# Controls whether to apply available eWallet credits toward the final AL
# application payment (only relevant when Credit Balance > RM 0.00 — with
# a zero balance there's no such option and payment always proceeds
# directly). Defaults to false.
USE_EWALLET_CREDITS=false

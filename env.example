# .env
# Copy this file to .env and fill in your values

# Your Gmail address (the one that will receive the OTP)
GMAIL_ADDRESS=sansolstesting@outlook.com

# Optional: override the login URL
SSO_URL=https://demo.aliance.club/sso/login/

# Dev/demo mode: bypass Gmail and use a fixed "decoy" OTP
# - Set DECOY_OTP=true to skip Gmail polling and always enter DECOY_OTP_CODE
DECOY_OTP=true
DECOY_OTP_CODE=122222
# Set USE_2FA=true only if the SSO login page requires clicking the "Login Via 2FA Code" button
# before OTP input fields appear. Set to false (default) to skip that click.
USE_2FA=false

# Company and Module Selection
# - COMPANY_NAME: Name of the company to select
# - MODULE_NAME: Name of the module/submodule to select (e.g., "JobSarawak")
COMPANY_NAME=SYARIKAT PEMBANGUNAN PESAWAT SEMBILAN SEPTEMBER
MODULE_NAME=JobSarawak
MODULE_NAME_ADMIN=Job Sarawak

# Job Creation Settings
# - JOB_TYPE_NRE: Set to true to create NRE (Non-Resident Employee / foreign worker) job
#   When true  → clicks YES on the popup (NRE job)
#   When false → clicks NO on the popup (local job)
JOB_TYPE_NRE=true

ADMIN_EMAIL=jsdemo.perkeso@outlook.com

# Path to the PDF file to upload for Radio Attachments (use forward slashes or double backslashes)
# Example: C:/Users/USER/Documents/radio-ad.pdf
PDF_UPLOAD_PATH=C:/Users/USER/Downloads/playwright-js-testfile/radio-ad.pdf